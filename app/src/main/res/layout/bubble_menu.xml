<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menu_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/menu_panel"
        android:layout_width="230dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/menu_panel_bg"
        android:clipToOutline="true"
        android:layout_gravity="top|start"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp">

        <!-- Search bar and dismiss action -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="2dp">

            <EditText
                android:id="@+id/menu_search"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:background="@drawable/search_input_bg"
                android:hint="Search name, code or +dial…"
                android:textSize="11sp"
                android:textColor="#18181B"
                android:textColorHint="#71717A"
                android:singleLine="true"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:alpha="0.9" />

            <ImageButton
                android:id="@+id/menu_dismiss"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Turn off floating bubble"
                android:padding="10dp"
                android:src="@drawable/ic_exit_fill" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E4E4E7" />

        <ScrollView
            android:id="@+id/menu_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="vertical"
            android:layout_marginTop="2dp">

            <LinearLayout
                android:id="@+id/menu_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="4dp" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
