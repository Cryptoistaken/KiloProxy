<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/country_row"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:background="?android:attr/selectableItemBackground">

    <TextView
        android:id="@+id/row_flag"
        android:layout_width="22dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/row_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#18181B"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/row_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:textSize="11sp"
        android:textColor="#71717A" />

    <TextView
        android:id="@+id/row_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/connected"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="#16A34A"
        android:visibility="gone" />

    <View
        android:id="@+id/row_dot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="2dp"
        android:background="@drawable/signal_dot"
        android:visibility="gone" />
</LinearLayout>